@model HotelApp.Web.Models.ReservationFormViewModel
@{
    ViewData["Title"] = "Nueva reserva";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<h1>Nueva reserva</h1>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form asp-action="Create" method="post">
    <h5 class="mt-3">Habitación y fechas</h5>

    <div class="mb-3">
        <label asp-for="RoomId" class="form-label">Habitación</label>
        <select asp-for="RoomId" class="form-select">
            <option value="">-- Seleccione una habitación --</option>
            @foreach (var r in Model.Rooms)
            {
                <option value="@r.Id"
                        data-rate="@r.Rate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        data-capacity="@r.Capacity">@r.Label</option>
            }
        </select>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="CheckIn" class="form-label">Entrada</label>
            <input asp-for="CheckIn" type="date" min="@today" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="CheckOut" class="form-label">Salida</label>
            <input asp-for="CheckOut" type="date" min="@today" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="GuestCount" class="form-label">Cantidad de personas</label>
            <input asp-for="GuestCount" type="number" min="1" class="form-control" />
        </div>
    </div>

    <p id="resumen" class="text-muted"></p>

    <h5 class="mt-3">Huésped titular</h5>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="FirstName" class="form-label">Nombre</label>
            <input asp-for="FirstName" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="LastName" class="form-label">Apellido</label>
            <input asp-for="LastName" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="DocumentId" class="form-label">Documento de identidad</label>
        <input asp-for="DocumentId" class="form-control" />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Email" class="form-label">Correo (opcional)</label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Phone" class="form-label">Teléfono (opcional)</label>
            <input asp-for="Phone" class="form-control" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Reservar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

<script>
    (function () {
        var room = document.getElementById('RoomId');
        var checkIn = document.getElementById('CheckIn');
        var checkOut = document.getElementById('CheckOut');
        var info = document.getElementById('resumen');

        function update() {
            var opt = room.options[room.selectedIndex];
            if (!opt || !opt.value) { info.textContent = ''; return; }

            var capacity = parseInt(opt.dataset.capacity);
            var rate = parseFloat(opt.dataset.rate);
            var nights = Math.round((new Date(checkOut.value) - new Date(checkIn.value)) / 86400000);

            var text = 'Capacidad máxima: ' + capacity + ' personas.';
            if (nights > 0)
                text += ' ' + nights + ' noche(s) x ' + rate.toFixed(2) + ' = total ' + (nights * rate).toFixed(2);
            info.textContent = text;
        }

        [room, checkIn, checkOut].forEach(function (e) { e.addEventListener('change', update); });
        update();
    })();
</script>