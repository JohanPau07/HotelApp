@model HotelApp.Web.Models.RoomTypeFormViewModel

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="mb-3">
    <label asp-for="Name" class="form-label">Nombre</label>
    <input asp-for="Name" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="BaseRate" class="form-label">Tarifa base</label>
    <input asp-for="BaseRate" type="number" step="0.01" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="Capacity" class="form-label">Capacidad (personas)</label>
    <input asp-for="Capacity" type="number" min="1" class="form-control" />
</div>