@model HotelApp.DAL.Models.Base.RoomTypeBase

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label">Nombre</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="BaseRate" class="form-label">Tarifa base</label>
    <input asp-for="BaseRate" type="number" step="0.01" class="form-control" />
    <span asp-validation-for="BaseRate" class="text-danger"></span>
</div>