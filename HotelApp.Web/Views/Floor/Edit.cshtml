@model HotelApp.Web.Models.FloorFormViewModel
@{
    ViewData["Title"] = "Editar piso";
}

<h1>Editar piso</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" asp-route-blockId="@Model.ReturnBlockId" class="btn btn-secondary">Cancelar</a>
</form>