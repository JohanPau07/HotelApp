@model HotelApp.Web.Models.FloorIndexViewModel
@{
    ViewData["Title"] = "Pisos";
}

<h1>Pisos@(Model.BlockName is not null ? " de " + Model.BlockName : "")</h1>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<p><a asp-action="Create" asp-route-returnBlockId="@Model.BlockId" class="btn btn-primary">Nuevo piso</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Número</th>
            <th>Hotel</th>
            <th>Bloque</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Number</td>
                <td>@Model.HotelNames.GetValueOrDefault(item.HotelId, "-")</td>
                <td>@(item.BlockId is Guid blockId ? Model.BlockNames.GetValueOrDefault(blockId, "-") : "-")</td>
                <td>@(item.IsActive ? "Sí" : "No")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnBlockId="@Model.BlockId" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" asp-route-blockId="@Model.BlockId" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este piso?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>