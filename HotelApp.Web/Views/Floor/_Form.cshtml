@model HotelApp.Web.Models.FloorFormViewModel

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<input type="hidden" asp-for="ReturnBlockId" />

<div class="mb-3">
    <label asp-for="HotelId" class="form-label">Hotel</label>
    <select asp-for="HotelId" asp-items="Model.Hotels" class="form-select">
        <option value="">-- Seleccione un hotel --</option>
    </select>
</div>

<div class="mb-3">
    <label asp-for="BlockId" class="form-label">Bloque (opcional)</label>
    <select asp-for="BlockId" asp-items="Model.Blocks" class="form-select">
        <option value="">-- Sin bloque --</option>
    </select>
</div>

<div class="mb-3">
    <label asp-for="Number" class="form-label">Número de piso</label>
    <input asp-for="Number" type="number" class="form-control" />
</div>

<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">Activo</label>
</div>