@model HotelApp.Web.Models.BlockFormViewModel
@{
    ViewData["Title"] = "Editar bloque";
}

<h1>Editar bloque</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" asp-route-hotelId="@Model.ReturnHotelId" class="btn btn-secondary">Cancelar</a>
</form>