@model List<HotelApp.DAL.Models.Block>
@{
    ViewData["Title"] = "Bloques";
    var hotels = (Dictionary<Guid, string>)ViewBag.HotelNames;
}

<h1>Bloques</h1>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<p><a asp-action="Create" class="btn btn-primary">Nuevo bloque</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Hotel</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@hotels.GetValueOrDefault(item.HotelId, "-")</td>
                <td>@(item.IsActive ? "Sí" : "No")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este bloque?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>