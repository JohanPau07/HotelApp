@model HotelApp.Web.Models.BlockIndexViewModel
@{
    ViewData["Title"] = "Bloques";
}

<h1>Bloques@(Model.HotelName is not null ? " de " + Model.HotelName : "")</h1>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<p><a asp-action="Create" asp-route-returnHotelId="@Model.HotelId" class="btn btn-primary">Nuevo bloque</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Hotel</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@Model.HotelNames.GetValueOrDefault(item.HotelId, "-")</td>
                <td>@(item.IsActive ? "Sí" : "No")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnHotelId="@Model.HotelId" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" asp-route-hotelId="@Model.HotelId" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este bloque?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>