@model HotelApp.Web.Models.BlockFormViewModel

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<input type="hidden" asp-for="ReturnHotelId" />

<div class="mb-3">
    <label asp-for="HotelId" class="form-label">Hotel</label>
    <select asp-for="HotelId" asp-items="Model.Hotels" class="form-select">
        <option value="">-- Seleccione un hotel --</option>
    </select>
</div>

<div class="mb-3">
    <label asp-for="Name" class="form-label">Nombre</label>
    <input asp-for="Name" class="form-control" />
</div>

<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">Activo</label>
</div>