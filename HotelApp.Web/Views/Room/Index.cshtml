@model HotelApp.Web.Models.RoomIndexViewModel
@{
    ViewData["Title"] = "Habitaciones";
}

<h1>Habitaciones@(Model.FloorLabel is not null ? " de " + Model.FloorLabel : "")</h1>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<p><a asp-action="Create" asp-route-returnFloorId="@Model.FloorId" class="btn btn-primary">Nueva habitación</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Número</th>
            <th>Piso</th>
            <th>Tipo</th>
            <th>Capacidad</th>
            <th>Tarifa</th>
            <th>Estado</th>
            <th>Activa</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Number</td>
                <td>@Model.FloorLabels.GetValueOrDefault(item.FloorId, "-")</td>
                <td>@Model.RoomTypeNames.GetValueOrDefault(item.RoomTypeId, "-")</td>
                <td>@item.Capacity</td>
                <td>@item.Rate.ToString("N2")</td>
                <td>@Model.StatusNames.GetValueOrDefault(item.Status, "-")</td>
                <td>@(item.IsActive ? "Sí" : "No")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnFloorId="@Model.FloorId" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" asp-route-floorId="@Model.FloorId" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar esta habitación?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>