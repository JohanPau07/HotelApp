@model HotelApp.Web.Models.RoomFormViewModel
@{
    ViewData["Title"] = "Nueva habitación";
}

<h1>Nueva habitación</h1>

<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" asp-route-floorId="@Model.ReturnFloorId" class="btn btn-secondary">Cancelar</a>
</form>