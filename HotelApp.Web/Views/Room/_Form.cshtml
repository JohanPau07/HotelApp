@model HotelApp.Web.Models.RoomFormViewModel

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<input type="hidden" asp-for="ReturnFloorId" />

<div class="mb-3">
    <label asp-for="FloorId" class="form-label">Piso</label>
    <select asp-for="FloorId" asp-items="Model.Floors" class="form-select">
        <option value="">-- Seleccione un piso --</option>
    </select>
</div>

<div class="mb-3">
    <label asp-for="RoomTypeId" class="form-label">Tipo de habitación</label>
    <select asp-for="RoomTypeId" class="form-select">
        <option value="">-- Seleccione un tipo --</option>
        @foreach (var t in Model.RoomTypes)
        {
            <option value="@t.Id"
                    data-rate="@t.BaseRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                    data-capacity="@t.Capacity">@t.Name</option>
        }
    </select>
</div>

<div class="mb-3">
    <label asp-for="Number" class="form-label">Número</label>
    <input asp-for="Number" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="Capacity" class="form-label">Capacidad</label>
    <input asp-for="Capacity" type="number" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="Rate" class="form-label">Tarifa</label>
    <input asp-for="Rate" type="number" step="0.01" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="Status" class="form-label">Estado</label>
    <select asp-for="Status" asp-items="Model.Statuses" class="form-select"></select>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label">Descripción</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
</div>

<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">Activa</label>
</div>

<script>
    document.getElementById('RoomTypeId').addEventListener('change', function () {
        var opt = this.options[this.selectedIndex];
        if (!opt.value) return;
        document.getElementById('Rate').value = opt.dataset.rate;
        document.getElementById('Capacity').value = opt.dataset.capacity;
    });
</script>